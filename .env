# ===========================================
# TotalSegmentator 环境配置文件
# 所有端口 +2000 避免与其他项目冲突
# ===========================================

# PostgreSQL 数据库配置 (5432 -> 7432)
POSTGRES_HOST=localhost
POSTGRES_PORT=7432
POSTGRES_USER=totalseg
POSTGRES_PASSWORD=totalseg_secret
POSTGRES_DB=totalseg

# MinIO 对象存储配置 (9000 -> 11000, 9001 -> 11001)
MINIO_ENDPOINT=localhost:11000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=totalseg-data
MINIO_SECURE=false
MINIO_API_PORT=11000
MINIO_CONSOLE_PORT=11001

# Redis 缓存配置 (6379 -> 8379)
REDIS_HOST=localhost
REDIS_PORT=8379
REDIS_PASSWORD=
REDIS_DB=0


# 应用配置
API_HOST=0.0.0.0
API_PORT=28000
DEBUG=false

# 数据持久化模式 (true=使用PostgreSQL+Redis, false=使用本地JSON文件)
USE_DATABASE=true

# Label Studio 配置
LABEL_STUDIO_URL=http://localhost:8899
LABEL_STUDIO_API_KEY=fa6e92902ed75a2fc9ef5c1da355b2e524bfb1bc
LABEL_STUDIO_PORT=8899

# MinIO 公开访问 URL (用于 Label Studio 访问图片)
MINIO_PUBLIC_URL=http://localhost:11000

