# ===========================================
# TotalSegmentator 环境配置文件
# 复制此文件为 .env 并根据需要修改
# ===========================================

# PostgreSQL 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=totalseg
POSTGRES_PASSWORD=totalseg_secret
POSTGRES_DB=totalseg

# MinIO 对象存储配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=totalseg-data
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM 配置
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TIMEOUT=120

# 应用配置
API_HOST=0.0.0.0
API_PORT=28000
DEBUG=false
SEGMENTATION_WORKER_COUNT=1
